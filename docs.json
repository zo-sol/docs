{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "IQLabs SDK",
  "colors": {
    "primary": "#00FF00",
    "light": "#00FF00",
    "dark": "#00CC00"
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "favicon": "/icon.png",
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": ["index"]
      },
      {
        "group": "Solana SDK",
        "pages": ["docs-typescript", "docs-python"]
      },
      {
        "group": "Ethereum SDK",
        "pages": ["docs-ethereum"]
      },
      {
        "group": "Monad",
        "pages": ["docs-monad"]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "X (Twitter)",
          "href": "https://x.com/IQLabsOfficial",
